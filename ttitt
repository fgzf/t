-- Camera Aim System
local isGuiding = false
local savedCFrame = nil
local guidingEnabled = true
local connection = nil

local function StartCameraAimLoop()
    if isGuiding or not guidingEnabled then return end
    isGuiding = true
    savedCFrame = Camera.CFrame

    UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
    UserInputService.MouseIconEnabled = false

    connection = RunService.Heartbeat:Connect(function()
        local camPos = Camera.CFrame.Position
        local goal, dist = getClosestGoal()
        if not goal then return end

        local arcHeight = getArc(dist)
        if not IsDunkAnimPlaying() then
            arcHeight = arcHeight - 6.5
        end

        local targetPos = goal.Position + Vector3.new(0, arcHeight, 0)

        Camera.CFrame = CFrame.new(camPos, targetPos)

        local screenPoint, onScreen = Camera:WorldToScreenPoint(targetPos)
        if onScreen then
            Mouse.X = screenPoint.X
            Mouse.Y = screenPoint.Y
            mousemoverel(0, 0)
        end
    end)
end

local function StopCameraAimLoop()
    if connection then
        connection:Disconnect()
        connection = nil
    end

    UserInputService.MouseBehavior = Enum.MouseBehavior.Default
    UserInputService.MouseIconEnabled = true

    if savedCFrame then
        Camera.CFrame = savedCFrame
        savedCFrame = nil
    end

    isGuiding = false
end

-- Character Setup
local function setupCharacter(char)
    local humanoid = char:WaitForChild("Humanoid")
    local rootPart = char:WaitForChild("HumanoidRootPart")

    -- DUNK LOGIC STILL WORKS
    humanoid:GetPropertyChangedSignal("Jump"):Connect(function()
        if humanoid.Jump and guidingEnabled then
            task.delay(0.1, function()
                if IsDunkAnimPlaying() then
                    StartCameraAimLoop()
                    task.delay(0.5, StopCameraAimLoop)
                end
            end)
        end
    end)

    char.ChildRemoved:Connect(function(child)
        if child.Name == "Basketball" and isGuiding then
            StopCameraAimLoop()
        end
    end)
end

if Player.Character then
    setupCharacter(Player.Character)
end
Player.CharacterAdded:Connect(setupCharacter)

-- X = Auto Jump + Set Power + Fast Lock + Shoot
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.X then
        
        local char = Player.Character
        if not char then return end

        local humanoid = char:FindFirstChild("Humanoid")
        local rootPart = char:FindFirstChild("HumanoidRootPart")
        local basketball = char:FindFirstChild("Basketball")

        if not humanoid or not rootPart or not basketball then return end

        -- SET POWER TO 100 WHEN PRESSING X
        local power = basketball:FindFirstChild("PowerValue")
        if power then
            power.Value = 100
            print("PowerValue set to:", power.Value)
        end

        -- FORCE JUMP
        humanoid.Jump = true

        -- FAST PEAK LOCK
        local hasRisen = false
        local peakConnection

        peakConnection = RunService.Heartbeat:Connect(function()
            local velY = rootPart.Velocity.Y
            if velY > 1 then hasRisen = true end

            if hasRisen and velY <= 0 then
                peakConnection:Disconnect()

                StartCameraAimLoop()
                wait(0.005)
                mouse1click()

                task.spawn(function()
                    task.wait()
                    StopCameraAimLoop()
                end)
            end
        end)
    end
end)
