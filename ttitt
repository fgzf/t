-- Detect Dunk Animation
local function IsDunkAnimPlaying()
    if not Player.Character or not Player.Character:FindFirstChild("Humanoid") then
        return false
    end
    for _, Anim in next, Player.Character.Humanoid:GetPlayingAnimationTracks() do
        if Anim.Animation and Anim.Animation.Name == "Dunk1" then
            return true
        end
    end
    return false
end

-- Collect all Goal BaseParts
local Goals = {}
for _, Obj in next, workspace:GetDescendants() do
    if Obj.Name == "Goal" and Obj:IsA("BasePart") then
        table.insert(Goals, Obj)
    end
end

-- Arc calculation
local function getArc(dist)
    local arc
    if dist <= 10 then arc = 166 - ((dist / 10) * 5)
    elseif dist > 10 and dist < 18 then arc = 175
    elseif dist > 18 and dist < 25 then arc = 170
    elseif dist > 25 and dist < 32 then arc = 165
    elseif dist > 32 and dist < 40 then arc = 160
    elseif dist > 40 and dist < 47 then arc = 155
    elseif dist > 47 and dist < 54 then arc = 150
    elseif dist > 54 and dist < 57 then arc = 145
    elseif dist > 57 and dist < 63 then arc = 140
    elseif dist > 63 and dist < 69 then arc = 135
    elseif dist > 69 and dist < 72 then arc = 130
    elseif dist >= 73 and dist <= 77 then arc = 125
    elseif dist >= 80 and dist <= 86 then arc = 120
    elseif dist > 79 and dist < 82 then arc = 115
    elseif dist > 82 and dist < 84 then arc = 110
    elseif dist > 84 and dist < 88 then arc = 105
    elseif dist > 88 and dist < 91 then arc = 100
    elseif dist > 91 and dist < 92 then arc = 95
    elseif dist > 92 and dist < 93 then arc = 90
    elseif dist > 93 and dist < 94 then arc = 85
    elseif dist > 94 and dist < 95 then arc = 80
    elseif dist > 95 and dist < 96 then arc = 75
    elseif dist > 96 and dist < 97 then arc = 70
    else arc = 103 end
    return arc
end

-- Find closest Goal
local function getClosestGoal()
    local torso = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
    if not torso then return nil, math.huge end
    local closest, best = nil, math.huge
    for _, goal in ipairs(Goals) do
        local dist = (torso.Position - goal.Position).Magnitude
        if dist < best then best = dist; closest = goal end
    end
    return closest, best
end

